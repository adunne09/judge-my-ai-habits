]


def connect(path: pathlib.Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(str(path), check_same_thread=False)
    db.executescript(SCHEMA)
    # migrate databases created before these columns existed
    have = {r[1] for r in db.execute("PRAGMA table_info(sessions)")}
    for col, decl in (("complexity_p6", "REAL"), ("leverage", "REAL"), ("harness", "TEXT DEFAULT 'opencode'")):
        if col not in have:
            db.execute(f"ALTER TABLE sessions ADD COLUMN {col} {decl}")
    # Privacy: the database holds only analytics, so it can be copied to another
    # machine as is. Titles, working directories, and project ids are used while
    # scoring but never written; databases from before this rule are stripped on
    # first open (VACUUM so the text is physically gone, not just NULL).
    stale = db.execute(
        "SELECT COUNT(*) FROM sessions WHERE title IS NOT NULL OR directory IS NOT NULL OR project_id IS NOT NULL"
    ).fetchone()[0]
    if stale:
        db.execute("UPDATE sessions SET title = NULL, directory = NULL, project_id = NULL")
        db.commit()
        db.execute("VACUUM")
        print(f"privacy: stripped titles, directories, and project ids from {stale} rows; this database never stores them", file=sys.stderr)
    return db


def upsert(db, row):
    values = [None if c in REDACTED_COLUMNS else row.get(c) for c in COLUMNS]
    db.execute(
        f"INSERT OR REPLACE INTO sessions ({','.join(COLUMNS)}) VALUES ({','.join('?' * len(COLUMNS))})",
        values,
    )


