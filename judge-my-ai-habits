def find_opencode() -> str:
    found = shutil.which("opencode") or str(pathlib.Path.home() / ".opencode" / "bin" / "opencode")
    if not os.path.exists(found):
        sys.exit("error: could not find the `opencode` binary on PATH or in ~/.opencode/bin")
    return found


class OpenCode:
    """Harness adapter for OpenCode v2. Every adapter provides name, version(), sessions(), messages(id)."""

    name = "opencode"

    def __init__(self, binary: str):
        self.binary = binary

    def version(self) -> str:
        return subprocess.run([self.binary, "--version"], capture_output=True, text=True).stdout.strip()

    def get(self, path: str):
        # Write to a file: `opencode api` can truncate large responses written to a pipe.
        fd, tmp = tempfile.mkstemp(prefix="occ-", suffix=".json")
        try:
            with os.fdopen(fd, "wb") as f:
                proc = subprocess.run([self.binary, "api", "get", path], stdout=f, stderr=subprocess.PIPE)
            if proc.returncode != 0:
                raise RuntimeError(f"opencode api get {path} failed: {proc.stderr.decode(errors='replace')[:400]}")
            with open(tmp, encoding="utf-8") as f:
                return json.load(f)
        finally:
            os.unlink(tmp)

    def paged(self, path: str, first_order: str = "asc"):
        out, cursor = [], None
        while True:
            sep = "&" if "?" in path else "?"
            page = self.get(f"{path}{sep}limit=200&" + (f"cursor={cursor}" if cursor else f"order={first_order}"))
            out.extend(page.get("data") or [])
            cursor = (page.get("cursor") or {}).get("next")
            if not cursor or not page.get("data"):
                return out

    def sessions(self):
        return self.paged("/api/session", first_order="desc")

    def messages(self, session_id: str):
        return self.paged(f"/api/session/{session_id}/message", first_order="asc")


def open_opencode():
    oc = OpenCode(find_opencode())
    version = oc.version()
    if not re.search(r"\bv?2\.", version):
        print(f"warning: expected OpenCode v2, found {version!r}", file=sys.stderr)
    return oc


