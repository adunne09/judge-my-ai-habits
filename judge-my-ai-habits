def base_row(machine, session, children, opencode_version):
    created = (session.get("time") or {}).get("created") or 0
    local = dt.datetime.fromtimestamp(created / 1000)
    iso = local.isocalendar()
    tok = session.get("tokens") or {}
    cache = tok.get("cache") or {}
    own_total = sum(int(tok.get(k) or 0) for k in ("input", "output", "reasoning")) + int(cache.get("read") or 0) + int(cache.get("write") or 0)
    child_total, child_cost = 0, 0.0
    for c in children:
        ct = c.get("tokens") or {}
        cc = ct.get("cache") or {}
        child_total += sum(int(ct.get(k) or 0) for k in ("input", "output", "reasoning")) + int(cc.get("read") or 0) + int(cc.get("write") or 0)
        child_cost += float(c.get("cost") or 0)
    # A harness that doesn't record cost leaves it None: store NULL (unknown), not 0.
    cost_known = session.get("cost") is not None or any(c.get("cost") is not None for c in children)
    model = session.get("model") or {}
    return {
        "machine": machine,
        "session_id": session["id"],
        "harness": HARNESS,
        "title": session.get("title"),
        "directory": tidy((session.get("location") or {}).get("directory") or ""),
        "project_id": session.get("projectID"),
        "agent": session.get("agent"),
        "model": f"{model.get('providerID')}/{model.get('id')}" if model.get("id") else None,
        "fork_of": (session.get("fork") or {}).get("sessionID"),
        "launched_by_program": int(bool((session.get("metadata") or {}).get("source") or session.get("permissions"))),
        "launch_source": (session.get("metadata") or {}).get("source"),
        "created_at": dt.datetime.fromtimestamp(created / 1000, dt.timezone.utc).isoformat(timespec="seconds"),
        "created_ms": created,
        "updated_ms": (session.get("time") or {}).get("updated"),
        "day": local.strftime("%Y-%m-%d"),
        "week": f"{iso[0]}-W{iso[1]:02d}",
        "month": local.strftime("%Y-%m"),
        "outcome": session.get("outcome"),
        "subagent_sessions": len(children),
        "tokens_input": tok.get("input"),
        "tokens_output": tok.get("output"),
        "tokens_reasoning": tok.get("reasoning"),
        "tokens_cache_read": cache.get("read"),
        "tokens_cache_write": cache.get("write"),
        "tokens_total": own_total + child_total,
        "cost_usd": round(float(session.get("cost") or 0) + child_cost, 6) if cost_known else None,
        "opencode_version": opencode_version,
    }


def score_one(oc, jev, machine, session, children, opencode_version):
    row = base_row(machine, session, children, opencode_version)
    row["harness"] = oc.name
    row["scorer_hash"], row["scored_at"] = SCORER_HASH, dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    try:
        state, metrics, other_ai = analyze(session, oc.messages(session["id"]))
        row.update(metrics)
        if metrics["user_messages"] == 0 or metrics["assistant_messages"] == 0:
            row["status"] = "empty"
            return row, 0
        # child sessions are the authoritative count of subagents launched
        state["work_pattern"]["subagents_launched"] = max(len(children), state["work_pattern"]["subagents_launched"])
        resp = jev.ask(state, QUESTIONS)
        a = resp["answers"]
        cx = a["complexity"]
        probs = {int(k): v for k, v in cx["probabilities"].items()}
        org = a["origin"]["probabilities"]
        row.update({
            "status": "scored",
            "complexity": cx["score"],
            "complexity_confidence": cx["confidence"],
            **{f"complexity_p{i}": probs.get(i) for i in range(7)},
            "leverage": a["leverage"]["score"],
            **{k: a[k]["score"] for k in DIMENSIONS},
            "origin": a["origin"]["choice"],
            "origin_p_personal": org.get("personal_work"),
            "origin_p_scripted": org.get("scripted_job"),
            "origin_p_test": org.get("test_or_benchmark"),
            "answers_json": json.dumps({k: {kk: vv for kk, vv in v.items() if kk != "legend"} for k, v in a.items()}),
            "jev_model": resp.get("model"),
            "state_tokens": (resp.get("usage") or {}).get("input_tokens"),
        })
        return row, row["state_tokens"] or 0
    except Exception as e:  # keep going; the row records the failure and is retried next run
        row["status"], row["error"] = "error", str(e)[:1000]
        return row, 0


def cmd_score(args):
    api_key = os.environ.get("TYPESAFE_API_KEY")
    oc = HARNESSES[args.harness]()
    version = oc.version()
    machine = args.machine or socket.gethostname().split(".")[0]
    db = connect(pathlib.Path(args.db).expanduser())
    jev = Jev(api_key or "", args.model)

    print(f"machine={machine} harness={oc.name} version={version} model={args.model} scorer={SCORER_HASH} db={args.db}", file=sys.stderr)
    all_sessions = oc.sessions()
    children = {}
    for s in all_sessions:
        if s.get("parentID"):
            children.setdefault(s["parentID"], []).append(s)
    roots = [s for s in all_sessions if not s.get("parentID")]
    if args.since:
        cutoff = dt.datetime.fromisoformat(args.since).timestamp() * 1000
        roots = [s for s in roots if (s.get("time") or {}).get("created", 0) >= cutoff]
    if args.session:
        roots = [s for s in roots if s["id"] in set(args.session)]

    done = {}
    for sid, updated, status, scorer, model in db.execute("SELECT session_id, updated_ms, status, scorer_hash, jev_model FROM sessions WHERE machine = ? AND harness = ?", (machine, oc.name)):
        done[sid] = (updated, status, scorer, model)

    def stale(s):
        prev = done.get(s["id"])
        if args.rescore or prev is None:
            return True
        updated, status, scorer, _ = prev
        return status == "error" or scorer != SCORER_HASH or updated != (s.get("time") or {}).get("updated")

    todo = [s for s in roots if stale(s)]
    todo.sort(key=lambda s: -((s.get("time") or {}).get("created") or 0))
    if args.limit:
        todo = todo[: args.limit]
    print(f"{len(all_sessions)} sessions ({len(roots)} top-level); {len(todo)} to score", file=sys.stderr)

    # Nothing to score runs fine without a key, so a rerun that only refreshes
    # the report and dashboard needs no credentials.
    if todo and not api_key and not args.dry_run:
        sys.exit("error: set TYPESAFE_API_KEY (get one at https://console.typesafe.ai)")

    if args.dry_run:
        for s in todo[: args.limit or 3]:
            state, metrics, _ = analyze(s, oc.messages(s["id"]))
            print(json.dumps({"session_id": s["id"], "metrics": metrics, "state": state}, indent=2, ensure_ascii=False))
        return

    started = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    lock = threading.Lock()
    counts = {"scored": 0, "empty": 0, "error": 0}
    tokens = 0
    t0 = time.time()
    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(score_one, oc, jev, machine, s, children.get(s["id"], []), version) for s in todo]
        for i, fut in enumerate(as_completed(futures), 1):
            row, used = fut.result()
            with lock:
                upsert(db, row)
                counts[row["status"]] += 1
                tokens += used
                if i % 25 == 0 or i == len(futures):
                    db.commit()
                    print(f"  {i}/{len(futures)}  scored={counts['scored']} empty={counts['empty']} errors={counts['error']}  {time.time() - t0:.0f}s", file=sys.stderr)
                if row["status"] == "error":
                    print(f"  error {row['session_id']}: {row['error'][:200]}", file=sys.stderr)
    db.execute("INSERT INTO runs VALUES (?,?,?,?,?,?,?,?,?,?)", (machine, started, dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), version, args.model, SCORER_HASH, len(roots), counts["scored"], counts["error"], tokens))
    db.commit()
    print(f"done: {counts}; Jev input tokens {tokens:,} (~${tokens * 0.042 / 1e6:.4f})", file=sys.stderr)
    print(f"database: {pathlib.Path(args.db).expanduser()}", file=sys.stderr)
    try:
        print(f"dashboard: {render_dashboard(args.db)}", file=sys.stderr)
    except Exception as e:  # the scores are saved either way
        print(f"warning: could not render the dashboard: {e}", file=sys.stderr)


def cmd_merge(args):
    out = connect(pathlib.Path(args.output).expanduser())
    for src in args.inputs:
        out.execute("ATTACH DATABASE ? AS src", (str(pathlib.Path(src).expanduser()),))
        # Inputs may predate newer columns; copy the shared ones and let defaults fill the rest.
        # Titles, directories, and project ids are never copied: a database stays shareable after a merge.
        have = {r[1] for r in out.execute("PRAGMA src.table_info(sessions)")}
        cols = ",".join(c for c in COLUMNS if c in have and c not in REDACTED_COLUMNS)
        n = out.execute(f"INSERT OR REPLACE INTO sessions ({cols}) SELECT {cols} FROM src.sessions").rowcount
        try:
            out.execute("INSERT INTO runs SELECT * FROM src.runs")
        except sqlite3.OperationalError:
            pass
        out.commit()
        out.execute("DETACH DATABASE src")
        print(f"merged {n} rows from {src}", file=sys.stderr)
    hashes = out.execute("SELECT scorer_hash, jev_model, COUNT(*) FROM sessions WHERE status='scored' GROUP BY 1, 2").fetchall()
    if len(hashes) > 1:
        print("warning: rows were scored with different question sets or models; compare like with like:", file=sys.stderr)
        for h in hashes:
            print(f"  scorer={h[0]} model={h[1]} rows={h[2]}", file=sys.stderr)


DAY_MS = 86_400_000
DASHBOARD_TEMPLATE = pathlib.Path(__file__).resolve().parent / "dashboard.html"


def dashboard_payload(db, db_path, recent_days=30, baseline_days=180):
    cols = ("session_id, harness, machine, created_ms, complexity, leverage, tokens_total, cost_usd, origin, fork_of, launched_by_program, "
            "scope, expertise, systems, open_endedness, " + ", ".join(f"complexity_p{i}" for i in range(7)) +
            ", tool_calls, subagent_sessions, user_messages, active_seconds, jev_model, scorer_hash")
    r2 = lambda v, n=3: None if v is None else round(v, n)  # noqa: E731
    sessions = []
    for r in db.execute(f"SELECT {cols} FROM sessions WHERE status = 'scored' AND complexity IS NOT NULL"):
        (sid, harness, machine, created, cx, lev, tokens, cost, origin, fork, launched,
         scope, expertise, systems, open_e, *rest) = r
        probs, (tools, subs, users, active, _, _) = rest[:7], rest[7:]
        sessions.append({
            "id": sid, "h": harness or "opencode", "m": machine, "t": created,
            "c": r2(cx), "l": r2(lev), "k": tokens, "$": r2(cost, 4), "o": origin or "unknown",
            "f": int(bool(fork)), "lp": int(bool(launched)),
            "p": int(origin == "personal_work" and not fork and not launched),
            "sc": r2(scope, 2), "ex": r2(expertise, 2), "sy": r2(systems, 2), "oe": r2(open_e, 2),
            "pr": [r2(p) for p in probs], "tc": tools, "sa": subs, "um": users, "as": active,
        })
    models = [m for (m,) in db.execute("SELECT DISTINCT jev_model FROM sessions WHERE status='scored' AND jev_model IS NOT NULL")]
    scorers = [h for (h,) in db.execute("SELECT DISTINCT scorer_hash FROM sessions WHERE status='scored' AND scorer_hash IS NOT NULL")]
    return {"meta": {"generated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), "db": tidy(str(db_path)),
                     "models": models, "scorers": scorers, "recent_days": recent_days, "baseline_days": baseline_days},
            "sessions": sessions}


def render_dashboard(db_path, out=None, recent_days=30, baseline_days=180):
    """Fill the dashboard template with the database's scored sessions; return the output path."""
    db_path = pathlib.Path(db_path).expanduser()
    if not DASHBOARD_TEMPLATE.exists():
        raise FileNotFoundError(f"dashboard template not found at {DASHBOARD_TEMPLATE}")
    db = sqlite3.connect(str(db_path))
    payload = json.dumps(dashboard_payload(db, db_path, recent_days, baseline_days), separators=(",", ":"), ensure_ascii=False)
    html = DASHBOARD_TEMPLATE.read_text(encoding="utf-8").replace("__JMAIH_DATA__", payload.replace("</", "<\\/"))
    out = pathlib.Path(out).expanduser() if out else db_path.parent / "dashboard.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(html, encoding="utf-8")
    return out


def cmd_dashboard(args):
    path = render_dashboard(args.db, args.output, args.recent_days, args.baseline_days)
    print(path)
    if args.open:
        subprocess.run(["open" if sys.platform == "darwin" else "xdg-open", str(path)], check=False)


def human_tokens(n):
    for unit, size in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if abs(n) >= size:
            return f"{n / size:.2f}{unit}"
    return f"{n:.0f}"


def pct_change(new, old):
    return f"{(new - old) / old * 100:+.1f}%" if old else "n/a"


def describe(xs):
    """n, mean, sd, median of a list of numbers (None for an empty list)."""
    if not xs:
        return None
    n = len(xs)
    mean = sum(xs) / n
    sd = math.sqrt(sum((x - mean) ** 2 for x in xs) / (n - 1)) if n > 1 else 0.0
    return n, mean, sd, sorted(xs)[n // 2]


def day_ms(s, end_of_day=False):
    d = dt.datetime.fromisoformat(s)
    if end_of_day and len(s) <= 10:
        d += dt.timedelta(days=1)
    return int(d.timestamp() * 1000)


def fmt_day(ms):
    return dt.datetime.fromtimestamp(ms / 1000).strftime("%b %-d, %Y")


def histogram(values, width, count):
    bins = [0] * count
    for v in values:
        bins[min(count - 1, int(v / width))] += 1
    top = max(bins) or 1
    for i, c in enumerate(bins):
        print(f"  {i * width:4.2f}-{(i + 1) * width:4.2f} | {'█' * round(40 * c / top):<40} {c}")


def window_summary(rows, days):
    """rows: (created_ms, period, complexity, leverage, tokens). days: window length actually covered."""
    cx = describe([r[2] for r in rows])
    lev = describe([r[3] for r in rows if r[3] is not None])
    tok = [r[4] for r in rows if r[4] is not None]
    per30 = 30 / days if days else 0
    return {
        "n": len(rows), "days": days, "sessions_30d": len(rows) * per30,
        "cx": cx, "lev": lev,
        "tokens": sum(tok), "tokens_30d": sum(tok) * per30,
        "tok_mean": sum(tok) / len(tok) if tok else 0, "tok_median": sorted(tok)[len(tok) // 2] if tok else 0,
    }


def print_change(rows, end_ms, recent_days, baseline_days):
    data_start = rows[0][0]
    recent_lo = max(end_ms - recent_days * DAY_MS, data_start)
    base_hi = recent_lo
    base_lo = max(base_hi - baseline_days * DAY_MS, data_start)
    recent = [r for r in rows if recent_lo <= r[0] < end_ms]
    base = [r for r in rows if base_lo <= r[0] < base_hi]
    r_days, b_days = (end_ms - recent_lo) / DAY_MS, (base_hi - base_lo) / DAY_MS
    note = lambda got, want: "" if got >= want - 0.5 else f"; all the history there is, {want} requested"  # noqa: E731
    print(f"\nCHANGE — last {recent_days} days vs the {baseline_days} days before:")
    print(f"  recent:   {fmt_day(recent_lo)} – {fmt_day(end_ms - 1)} ({r_days:.0f} days{note(r_days, recent_days)})")
    if not base:
        print("  baseline: none — there is no history before the recent window yet, so there's nothing to compare against")
        return
    print(f"  baseline: {fmt_day(base_lo)} – {fmt_day(base_hi - 1)} ({b_days:.0f} days{note(b_days, baseline_days)})\n")
    R, B = window_summary(recent, r_days), window_summary(base, b_days)
    lines = [("sessions", f"{R['n']}", f"{B['n']}", "")]
    lines.append(("sessions per 30 days", f"{R['sessions_30d']:.0f}", f"{B['sessions_30d']:.0f}", pct_change(R["sessions_30d"], B["sessions_30d"])))
    if R["cx"] and B["cx"]:
        (_, rm, _, rmed), (_, bm, bsd, bmed) = R["cx"], B["cx"]
        sd_units = f", {(rm - bm) / bsd:+.2f} sd" if bsd else ""
        lines.append(("complexity mean", f"{rm:.2f}", f"{bm:.2f}", f"{rm - bm:+.2f} ({pct_change(rm, bm)}{sd_units})"))
        lines.append(("complexity median", f"{rmed:.2f}", f"{bmed:.2f}", f"{rmed - bmed:+.2f}"))
    if R["lev"] and B["lev"]:
        lines.append(("leverage mean", f"{R['lev'][1]:.2f}", f"{B['lev'][1]:.2f}", f"{R['lev'][1] - B['lev'][1]:+.2f}"))
    lines.append(("tokens per 30 days", human_tokens(R["tokens_30d"]), human_tokens(B["tokens_30d"]), pct_change(R["tokens_30d"], B["tokens_30d"])))
    lines.append(("tokens per session, mean", human_tokens(R["tok_mean"]), human_tokens(B["tok_mean"]), pct_change(R["tok_mean"], B["tok_mean"])))
    lines.append(("tokens per session, median", human_tokens(R["tok_median"]), human_tokens(B["tok_median"]), pct_change(R["tok_median"], B["tok_median"])))
    print(f"  {'':28}{'recent':>10}{'baseline':>11}   change")
    for label, r, b, c in lines:
        print(f"  {label:28}{r:>10}{b:>11}   {c}")


def cmd_report(args):
    db = sqlite3.connect(str(pathlib.Path(args.db).expanduser()))
    since_ms = day_ms(args.since) if args.since else None
    until_ms = day_ms(args.until, end_of_day=True) if args.until else None
    win, params = "", []
    if since_ms is not None:
        win, params = win + " AND created_ms >= ?", params + [since_ms]
    if until_ms is not None:
        win, params = win + " AND created_ms < ?", params + [until_ms]

    if args.all:
        table = "sessions WHERE status='scored'"
        print("\nAll scored sessions (--all; includes tests, scripted jobs, and forks)")
    else:
        # Personal sessions are the ones the trend tracks; show the funnel from
        # everything scored down to them.
        q = lambda cond: db.execute(f"SELECT COUNT(*) FROM sessions WHERE {cond}{win}", params).fetchone()[0]  # noqa: E731
        total, unscored = q("1=1"), q("status != 'scored'")
        non_personal = q("status='scored' AND origin IS NOT 'personal_work'")
        forks = q("status='scored' AND fork_of IS NOT NULL")
        launcher = q("status='scored' AND launched_by_program = 1")
        personal = q("status='scored' AND origin='personal_work' AND fork_of IS NULL AND launched_by_program = 0")
        print("\nPERSONAL SESSIONS — scored, personal work, not forks, launched by a human:")
        print(f"  {total} sessions -> {personal} analyzed below "
              f"(excluded: {unscored} unscored, {non_personal} scripted/test/benchmark, "
              f"{forks} forks, {launcher} launcher-created; categories may overlap)")
        table = "human_sessions WHERE 1=1"
    period = {"month": "month", "week": "week", "day": "day"}[args.by]
    rows = db.execute(f"SELECT created_ms, {period}, complexity, leverage, tokens_total FROM {table}{win} ORDER BY created_ms", params).fetchall()
    if not rows:
        print("no scored sessions in this period")
        return
    first, last = rows[0][0], rows[-1][0]
    label = "all time" if not (args.since or args.until) else f"{args.since or 'start'} to {args.until or 'now'}"
    print(f"  period: {label} ({fmt_day(first)} – {fmt_day(last)})")

    end_ms = until_ms if until_ms is not None else int(time.time() * 1000)
    print_change(rows, end_ms, args.recent_days, args.baseline_days)

    n, mean, sd, med = describe([r[2] for r in rows])
    print(f"\nComplexity: n={n} mean={mean:.2f} sd={sd:.2f} median={med:.2f}")
    print("levels: 0 minutes · 1 <1h · 2 few hours · 3 a day · 4 several days · 5 weeks · 6 months for a team\n")
    histogram([r[2] for r in rows], 0.25, 24)

    lev = [r[3] for r in rows if r[3] is not None]
    if lev:
        print(f"\nLeverage: n={len(lev)} mean={sum(lev) / len(lev):.2f}")
        print("levels: 0 answered from knowledge · 1 a lookup or two · 2 steered step by step · 3 delegated a goal · 4 orchestrated agents · 5 autonomous loop\n")
        histogram(lev, 0.5, 10)

    tok = [r[4] for r in rows if r[4] is not None] or [0]
    span_days = max(1.0, (end_ms - first) / DAY_MS)
    print(f"\nTokens (including subagents): total {human_tokens(sum(tok))} · per 30 days {human_tokens(sum(tok) * 30 / span_days)}"
          f" · per session mean {human_tokens(sum(tok) / len(tok))}, median {human_tokens(sorted(tok)[len(tok) // 2])}")

    print(f"\nBy {args.by}:")
    groups = {}
    for r in rows:
        groups.setdefault(r[1], []).append(r)
    for p, rs in groups.items():
        n, mean, sd, med = describe([r[2] for r in rs])
        print(f"  {p}  n={n:4d}  complexity mean={mean:.2f} sd={sd:.2f} median={med:.2f}  tokens={human_tokens(sum(r[4] for r in rs if r[4] is not None)):>7}  {'▇' * round(mean * 8)}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    s = sub.add_parser("score", help="score sessions on this machine (default)")
    s.add_argument("--harness", choices=sorted(HARNESSES), default="opencode", help="which agent harness to read sessions from (default opencode)")
    s.add_argument("--db", default=str(DEFAULT_DB), help=f"SQLite output (default {DEFAULT_DB})")
    s.add_argument("--machine", help="machine label stored with each row (default: short hostname)")
    s.add_argument("--model", default=DEFAULT_MODEL, help=f"Jev model; pinned so scores stay comparable over time (default {DEFAULT_MODEL})")
    s.add_argument("--workers", type=int, default=6)
    s.add_argument("--since", help="only sessions created on or after this date (YYYY-MM-DD)")
    s.add_argument("--limit", type=int, help="score at most N sessions (newest first)")
    s.add_argument("--session", action="append", help="score only this session id (repeatable)")
    s.add_argument("--rescore", action="store_true", help="rescore sessions even if unchanged")
    s.add_argument("--dry-run", action="store_true", help="print the state Jev would see, without calling Jev")
    m = sub.add_parser("merge", help="merge databases from several machines into one")
    m.add_argument("inputs", nargs="+")
    m.add_argument("-o", "--output", required=True)
    r = sub.add_parser("report", help="print the distribution, its trend, and the recent change")
    r.add_argument("--db", default=str(DEFAULT_DB))
    r.add_argument("--by", choices=["month", "week", "day"], default="month")
    r.add_argument("--all", action="store_true", help="include tests, scripted jobs, and forks")
    r.add_argument("--since", help="only sessions created on or after this date, YYYY-MM-DD (default: all history)")
    r.add_argument("--until", help="only sessions created on or before this date, YYYY-MM-DD (default: now); also ends the recent window")
    r.add_argument("--recent-days", type=int, default=30, help="length of the recent window compared against the baseline (default 30)")
    r.add_argument("--baseline-days", type=int, default=180, help="length of the baseline window just before the recent one (default 180)")
    d = sub.add_parser("dashboard", help="render the interactive HTML dashboard and print its path")
    d.add_argument("--db", default=str(DEFAULT_DB))
    d.add_argument("-o", "--output", help="where to write the HTML (default: dashboard.html next to the database)")
    d.add_argument("--recent-days", type=int, default=30, help="initial recent window (default 30; changeable in the page)")
    d.add_argument("--baseline-days", type=int, default=180, help="initial baseline window (default 180; changeable in the page)")
    d.add_argument("--open", action="store_true", help="open it in the default browser")
    argv = sys.argv[1:]
    if not argv or argv[0] not in ("score", "merge", "report", "dashboard", "-h", "--help"):
        argv = ["score"] + argv
    args = p.parse_args(argv)
    {"score": cmd_score, "merge": cmd_merge, "report": cmd_report, "dashboard": cmd_dashboard}[args.cmd](args)


if __name__ == "__main__":
    main()
