CC_TOOLS = {
    "Bash": "shell", "Read": "read", "Write": "write", "Edit": "edit", "MultiEdit": "multiedit", "NotebookEdit": "edit",
    "Glob": "glob", "Grep": "grep", "Agent": "subagent", "Task": "subagent", "WebFetch": "webfetch", "WebSearch": "websearch",
    "Skill": "skill", "AskUserQuestion": "question", "TodoWrite": "todowrite", "TaskCreate": "todowrite", "TaskUpdate": "todowrite",
    "mcp__ccd_turn__update_plan": "todowrite", "mcp__workspace__bash": "shell", "mcp__workspace__web_fetch": "webfetch",
}
# Harness bookkeeping with no counterpart in other harnesses: loading tool schemas,
# reading back the todo list, the desktop app's end-of-turn summary card, and
# Cowork's folder-access prompts and file cards.
CC_PLUMBING = {"ToolSearch", "TaskList", "TaskGet", "mcp__ccd_turn__wrap_up", "mcp__cowork__request_cowork_directory",
               "mcp__cowork__allow_cowork_file_delete", "mcp__cowork__present_files", "mcp__cowork__send_user_message"}
# Entrypoints that mean a program started the session: `claude -p` and the Agent SDKs.
CC_PROGRAM_ENTRYPOINTS = {"sdk-cli", "sdk-ts", "sdk-py"}
# User-role text that Claude Code injects rather than the person typing it.
CC_SYNTHETIC = re.compile(r"^\s*(?:\[Request interrupted by user|<local-command-|<bash-std|<task-notification>|<user-prompt-submit-hook>|Caveat: The messages below were generated)")
# Built-in slash commands that change settings or the UI instead of sending a prompt.
CC_UI_COMMANDS = {"/clear", "/compact", "/model", "/config", "/help", "/resume", "/cost", "/status", "/login", "/logout", "/exit", "/quit",
                  "/mcp", "/permissions", "/memory", "/context", "/usage", "/doctor", "/theme", "/agents", "/hooks", "/ide", "/rename", "/fast"}
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
# Per-session temp directories, e.g. /private/tmp/claude-502/-Users-me/<session id>/scratchpad. Shortened
# like home paths are; left as is, the `/claude-502` in them reads as running the `claude` CLI.
CC_TMP = re.compile(r"(?:/private)?/tmp/claude-\d+/[^/\s'\"]+/[0-9a-f-]{36}(?:/scratchpad)?")


def iso_ms(ts):
    try:
        return int(dt.datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return None


def read_jsonl(path):
    # Claude Code appends to transcripts while it runs, so skip a partial last line.
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if isinstance(r, dict):
                yield r


def cc_text(content):
    """(text, image count) of a user message's content: a string or a list of blocks."""
    if isinstance(content, str):
        return content, 0
    blocks = [b for b in content or [] if isinstance(b, dict)]
    if any(b.get("type") == "tool_result" for b in blocks):
        return "", 0
    return "\n".join(b.get("text") or "" for b in blocks if b.get("type") == "text"), sum(1 for b in blocks if b.get("type") == "image")


def cc_usage(records):
    """Token usage of transcript records. Content blocks of one API response share its message id and usage."""
    seen, tok = set(), {"input": 0, "output": 0, "reasoning": 0, "cache": {"read": 0, "write": 0}}
    for r in records:
        msg = r.get("message") or {}
        u = msg.get("usage")
        if r.get("type") != "assistant" or not isinstance(u, dict) or msg.get("id") in seen:
            continue
        seen.add(msg.get("id"))
        thinking = int((u.get("output_tokens_details") or {}).get("thinking_tokens") or 0)  # included in output_tokens
        tok["input"] += int(u.get("input_tokens") or 0)
        tok["output"] += int(u.get("output_tokens") or 0) - thinking
        tok["reasoning"] += thinking
        tok["cache"]["read"] += int(u.get("cache_read_input_tokens") or 0)
        tok["cache"]["write"] += int(u.get("cache_creation_input_tokens") or 0)
    return tok


class Claude:
    """Harness adapter for Claude: Claude Code and Claude Desktop's Cowork mode, which runs the same engine.

    Reads Claude Code's JSONL transcripts read-only: ~/.claude/projects (or
    $CLAUDE_CONFIG_DIR/projects) for the CLI, the IDE extensions, and the desktop
    app's Code tab, and each Cowork session's own projects folder. Subagent
    transcripts in <session>/subagents/ become child sessions. Desktop chats are
    kept in the account, not on disk, so they aren't read.
    """

    name = "claude"

    def __init__(self, root: pathlib.Path, desktop: pathlib.Path = DESKTOP):
        self.root, self.desktop = root, desktop
        self.paths = {}
        self.load_desktop_metadata()

    def transcripts(self):
        return sorted(self.root.glob("projects/*/*.jsonl")) + sorted(self.desktop.glob("local-agent-mode-sessions/*/*/local_*/.claude/projects/*/*.jsonl"))

    def version(self) -> str:
        files = sorted(self.transcripts(), key=lambda p: p.stat().st_mtime)
        version = None
        for r in read_jsonl(files[-1]) if files else []:
            version = r.get("version") or version
        return f"claude-code {version}" if version else "claude-code"

    def load_desktop_metadata(self):
        """Read what the desktop app keeps beside the transcripts, one file per Code-tab or Cowork session.

        It names claude.ai connectors' MCP servers by UUID and maps them to names; it
        holds Cowork's titles; and `cliSessionId` is the transcript the app shows,
        when a session has several (Cowork starts a new transcript on resume).
        """
        self.mcp_names, self.titles, self.folder_titles, self.current = {}, {}, {}, set()
        for f in list(self.desktop.glob("claude-code-sessions/*/*/local_*.json")) + list(self.desktop.glob("local-agent-mode-sessions/*/*/local_*.json")):
            try:
                meta = json.loads(f.read_text(encoding="utf-8"))
                for s in meta.get("remoteMcpServersConfig") or []:
                    if s.get("uuid") and s.get("name"):
                        self.mcp_names[s["uuid"]] = s["name"]
            except (OSError, ValueError, AttributeError):
                continue
            if meta.get("cliSessionId"):
                self.current.add(meta["cliSessionId"])
                if meta.get("title"):
                    self.titles[meta["cliSessionId"]] = meta["title"]
            if meta.get("title"):
                self.folder_titles[str(f.with_suffix(""))] = meta["title"]

    def tool_name(self, name):
        if name in CC_TOOLS:
            return CC_TOOLS[name]
        if name.startswith("mcp__") and "__" in name[5:]:
            server, tool = name[5:].split("__", 1)
            if UUID_RE.match(server) and server in self.mcp_names:
                server = self.mcp_names[server]
            elif server.startswith("claude_ai_"):  # the CLI's names for claude.ai connectors
                server = server[len("claude_ai_"):]
            else:
                return f"{server}.{tool}"
            return f"{re.sub(r'[^a-z0-9]+', '-', server.lower()).strip('-')}.{tool}"
        return name

    @staticmethod
    def tool_input(name, inp):
        if not isinstance(inp, dict):
            return inp
        if CC_TOOLS.get(name) == "todowrite":  # the list itself, like OpenCode's todowrite
            return {}
        inp = {k: CC_TMP.sub("$SCRATCHPAD", v) if isinstance(v, str) else v for k, v in inp.items()}
        path = inp.get("file_path") or inp.get("notebook_path")
        if path:
            inp["filePath"] = path
        if name == "Skill" and inp.get("skill"):
            inp["name"] = inp["skill"]
        return inp

    def record(self, path: pathlib.Path, sid: str, records, parent=None):
        """Session record for one transcript (SPEC.md section 3)."""
        stamps = [ms for ms in (iso_ms(r["timestamp"]) for r in records if r.get("timestamp")) if ms]
        titles = {"custom-title": None, "ai-title": None, "summary": None}
        for r in records:
            key = {"custom-title": "customTitle", "ai-title": "aiTitle", "summary": "summary"}.get(r.get("type"))
            if key and r.get(key):
                titles[r["type"]] = r[key]
        convo = [r for r in records if r.get("type") in ("user", "assistant")]
        models = [(r.get("message") or {}).get("model") for r in convo if r.get("type") == "assistant"]
        models = [m for m in models if m and m != "<synthetic>"]
        first = next((r for r in convo if r.get("type") == "user"), {})
        origin = (first.get("origin") or {}).get("kind")
        entry = first.get("entrypoint")
        source = None
        if origin not in (None, "human"):
            source = f"origin:{origin}"
        elif entry in CC_PROGRAM_ENTRYPOINTS and origin != "human":
            source = entry
        versions = [r["version"] for r in convo if r.get("version")]
        forked = next((r.get("forkedFrom") for r in records if isinstance(r.get("forkedFrom"), dict)), None)
        session = {
            "id": sid,
            "time": {"created": min(stamps) if stamps else int(path.stat().st_mtime * 1000), "updated": max(stamps) if stamps else None},
            "title": titles["custom-title"] or titles["ai-title"] or titles["summary"] or self.titles.get(sid)
            or (self.folder_titles.get(str(path.parents[3])) if len(path.parents) > 3 else None),
            "location": {"directory": next((r.get("cwd") for r in convo if r.get("cwd")), None)},
            "projectID": path.parent.name if parent is None else None,
            "model": {"providerID": "anthropic", "id": max(set(models), key=models.count)} if models else {},
            "tokens": cc_usage(convo),
            "cost": None,  # Claude Code does not record per-message cost
            "metadata": {"source": source, "entrypoint": entry},
            "version": versions[-1] if versions else None,
            "first_uuid": convo[0].get("uuid") if convo else None,
        }
        if forked and forked.get("sessionId"):
            session["fork"] = {"sessionID": forked["sessionId"]}
        if parent:
            session["parentID"] = parent
        return session

    def sessions(self):
        out = []
        for path in self.transcripts():
            records = list(read_jsonl(path))
            if path.stem.startswith("agent-"):  # older versions kept subagent transcripts beside the session
                parent = next((r.get("sessionId") for r in records if r.get("sessionId")), None)
                if parent:
                    out.append(self.record(path, f"{parent}/{path.stem}", records, parent))
                continue
            sid = path.stem
            self.paths[sid] = path
            main = [r for r in records if not r.get("isSidechain")]
            root = self.record(path, sid, main)
            children = []
            inline = [r for r in records if r.get("isSidechain")]  # older versions kept subagents inline
            if inline:
                children.append(self.record(path, f"{sid}/sidechain", inline, sid))
            for sub in sorted((path.parent / sid / "subagents").glob("*.jsonl")):
                children.append(self.record(sub, f"{sid}/{sub.stem}", list(read_jsonl(sub)), sid))
            # A session gains content when a subagent does, too.
            ups = [s["time"]["updated"] for s in [root] + children if s["time"]["updated"]]
            root["time"]["updated"] = max(ups) if ups else None
            out += [root] + children
        # Rewinding, branching, or resuming in Cowork copies a session's history, message uuids
        # included, into a new transcript. Of the transcripts that start with the same message,
        # the one the desktop app shows is the original, else the earliest; the rest are forks.
        copies = {}
        for s in out:
            if not s.get("parentID") and s["first_uuid"]:
                copies.setdefault(s["first_uuid"], []).append(s)
        for group in copies.values():
            group.sort(key=lambda s: (s["id"] not in self.current, s["time"]["created"]))
            for s in group[1:]:
                s.setdefault("fork", {"sessionID": group[0]["id"]})
        return out

    def messages(self, session_id: str):
        if session_id not in self.paths:
            self.sessions()
        out, steps = [], {}
        for r in read_jsonl(self.paths[session_id]):
            t = r.get("type")
            if r.get("isSidechain"):
                continue
            created = iso_ms(r.get("timestamp")) if r.get("timestamp") else None
            if t == "user":
                if r.get("isMeta") or r.get("isCompactSummary") or r.get("toolUseResult") is not None:
                    continue
                if (r.get("origin") or {}).get("kind") not in (None, "human"):
                    continue
                text, images = cc_text((r.get("message") or {}).get("content"))
                self.add_user(out, text, images, created)
            elif t == "attachment":
                a = r.get("attachment") or {}
                if a.get("type") == "queued_command" and (a.get("origin") or {}).get("kind", "human") == "human" and not a.get("isMeta"):
                    # a message the person typed while the agent was busy, delivered mid-turn
                    text, images = cc_text(a.get("prompt"))
                    self.add_user(out, text, images, created)
                elif a.get("type") in ("file", "image", "pdf") and out and out[-1]["type"] == "user":
                    out[-1].setdefault("files", []).append({"name": a.get("displayPath") or a.get("filename")})
            elif t == "assistant":
                msg = r.get("message") or {}
                if msg.get("model") == "<synthetic>":  # error notices Claude Code writes itself
                    continue
                key = msg.get("id") or r.get("uuid")
                if key not in steps:
                    steps[key] = {"type": "assistant", "time": {"created": created}, "model": {"providerID": "anthropic", "id": msg.get("model")}, "content": []}
                    out.append(steps[key])
                for b in msg.get("content") or []:
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "text" and (b.get("text") or "").strip():
                        steps[key]["content"].append({"type": "text", "text": b["text"]})
                    elif b.get("type") == "tool_use" and b.get("name") not in CC_PLUMBING:
                        name = b.get("name") or "?"
                        steps[key]["content"].append({"type": "tool", "name": self.tool_name(name), "state": {"input": self.tool_input(name, b.get("input"))}})
        return out

    @staticmethod
    def add_user(out, text, images, created):
        text = re.sub(r"<system-reminder>.*?</system-reminder>", "", text or "", flags=re.S)
        text = re.sub(r"</?pasted_content[^>]*>", "", text).strip()
        if not text and not images or CC_SYNTHETIC.match(text):
            return
        shell = re.match(r"^<bash-input>(.*)</bash-input>$", text, re.S)
        if shell:  # the person ran a command with `!`
            out.append({"type": "shell", "time": {"created": created}, "command": shell.group(1).strip()})
            return
        cmd = re.search(r"<command-name>(.*?)</command-name>", text, re.S)
        if cmd:  # a slash command: keep what the person typed, drop the expansion
            name = cmd.group(1).strip()
            if name in CC_UI_COMMANDS:
                return
            args = re.search(r"<command-args>(.*?)</command-args>", text, re.S)
            text = f"{name} {args.group(1).strip() if args else ''}".strip()
        msg = {"type": "user", "time": {"created": created}, "text": text}
        if images:
            msg["files"] = [{"name": "image"}] * images
        out.append(msg)


def open_claude():
    root = pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR") or pathlib.Path.home() / ".claude").expanduser()
    adapter = Claude(root)
    if not adapter.transcripts():
        sys.exit(f"error: no Claude transcripts found in {root / 'projects'} or {DESKTOP} (set CLAUDE_CONFIG_DIR if they live elsewhere)")
    return adapter


# Adapters by --harness id. A new harness adds an entry here; see SPEC.md.
HARNESSES = {"opencode": open_opencode, "claude": open_claude}


# ---------------------------------------------------------------------------
# Building the state Jev sees, and deterministic metrics
# ---------------------------------------------------------------------------


def squash(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def clip(s, head, tail=0):
    s = (s or "").strip()
    if len(s) <= head + tail + 40:
        return s
    return s[:head] + f"\n[… {len(s) - head - tail} characters omitted …]\n" + (s[-tail:] if tail else "")


def tidy(p):
    return str(p).replace(HOME, "~")


TOOL_REF = re.compile(r"tools(?:\.([A-Za-z_]\w*)|\[\"([\w-]+)\"\])(?:\.([A-Za-z_]\w*)|\[\"([\w-]+)\"\])?")
EDIT_TOOLS = {"write", "edit", "patch", "multiedit", "apply_patch"}


def describe_tool(part):
    name = part.get("name") or "?"
    inp = (part.get("state") or {}).get("input") or {}
    if not isinstance(inp, dict):
        return name
    if name in ("shell", "bash"):
        return f"shell: {squash(tidy(inp.get('command', '')), 140)}"
    if name in ("read",) or name in EDIT_TOOLS:
        return f"{name}: {tidy(inp.get('path') or inp.get('filePath') or '')}"
    if name in ("glob", "grep"):
        return f"{name}: {squash(inp.get('pattern', ''), 80)}"
    if name == "execute":
        code, calls = inp.get("code", ""), []
        for m in TOOL_REF.finditer(code):
            ns, fn = m.group(1) or m.group(2), m.group(3) or m.group(4)
            key = f"{ns}.{fn}" if fn else ns
            if key not in calls:
                calls.append(key)
        if not calls and "search(" in code:
            calls.append("tool search")
        return "execute: " + (", ".join(calls[:6]) if calls else squash(code, 100))
    if name in ("subagent", "task"):
        return f"subagent: {squash(inp.get('description') or inp.get('prompt', ''), 120)}"
    if name == "webfetch":
        return f"webfetch: {squash(inp.get('url', ''), 120)}"
    if name == "websearch":
        return f"websearch: {squash(inp.get('query', ''), 120)}"
    if name == "skill":
        return f"skill: {inp.get('id') or inp.get('name')}"
    if name == "question":
        return "asked user: " + squash("; ".join(q.get("question", "") for q in inp.get("questions") or []), 160)
    for v in inp.values():
        if isinstance(v, str) and v:
            return f"{name}: {squash(v, 100)}"
    return name


def collapse(items):
    out = []
    for t in items:
        if out and out[-1][0] == t:
            out[-1][1] += 1
        else:
            out.append([t, 1])
    return [t if n == 1 else f"{t} (×{n})" for t, n in out]


def sample_evenly(items, cap):
    if len(items) <= cap:
        return items
    head, tail = cap // 2, cap // 4
    middle = items[head : len(items) - tail]
    k = cap - head - tail
    step = len(middle) / k
    return items[:head] + [f"[… {len(items) - cap} more steps omitted …]"] + [middle[int(i * step)] for i in range(k)] + items[len(items) - tail :]


def cap_user_messages(users):
    size = lambda xs: sum(len(u["text"]) for u in xs)  # noqa: E731
    if size(users) <= USER_TOTAL_CHARS or len(users) <= 2:
        return users
    first, last, middle = users[0], users[-1], users[1:-1]
    front, back = [], []
    budget = USER_TOTAL_CHARS - size([first, last])
    while middle:
        take_front = len(front) <= len(back)
        u = middle[0] if take_front else middle[-1]
        if budget - len(u["text"]) < 0:
            break
        budget -= len(u["text"])
        if take_front:
            front.append(middle.pop(0))
        else:
            back.insert(0, middle.pop())
    gap = [{"text": f"[{len(middle)} follow-up messages omitted]"}] if middle else []
    return [first] + front + gap + back + [last]


IDLE_CAP_MS = 30 * 60 * 1000  # gaps longer than this are idle time, not agent work

# Other AI CLIs an agent might shell out to, evidence for the orchestration
# levels of the `leverage` question.
AI_TOOLS = re.compile(r"(?:^|[\s;&|/(])(codex|claude|gemini|cursor-agent|aider|amp|opencode run|aside|goose|droid)\b")


def human_duration(seconds):
    if seconds < 90:
        return "under 2 minutes"
    if seconds < 3600:
        return f"about {round(seconds / 60)} minutes"
    if seconds < 86400:
        return f"about {round(seconds / 3600, 1):g} hours"
    return f"about {round(seconds / 86400, 1):g} days"


def active_time(messages):
    """Sum of time between consecutive messages within each user turn.

    A turn starts at a user message and runs to the last activity before the
    next one. Each gap is capped at IDLE_CAP_MS so a session left open for
    days doesn't count as agent work.
    """
    active_ms, prev_ms, in_turn = 0.0, None, False
    for m in messages:
        created = (m.get("time") or {}).get("created")
        if not created:
            continue
        if m.get("type") == "user":
            in_turn, prev_ms = True, created
            continue
        if in_turn and prev_ms is not None:
            active_ms += min(max(0, created - prev_ms), IDLE_CAP_MS)
        prev_ms = created
    return active_ms


def analyze(session, messages):
    """Return (state for Jev, deterministic metrics, other AI CLIs invoked from shell)."""
    users, trace, tools, files = [], [], [], set()
    final_reply, assistant_count = "", 0
    first_ms, last_ms = None, None
    models, other_ai = set(), []
    for m in messages:
        t = m.get("type")
        created = (m.get("time") or {}).get("created")
        if created:
            first_ms = created if first_ms is None else min(first_ms, created)
            last_ms = created if last_ms is None else max(last_ms, created)
        if t == "user":
            entry = {"text": clip(m.get("text") or "", int(USER_MSG_CHARS * 0.8), int(USER_MSG_CHARS * 0.2))}
            extra = []
            if m.get("files"):
                extra.append(f"{len(m['files'])} attached file(s)")
            if m.get("skills"):
                extra.append("skills: " + ", ".join(str(s.get("name") or s.get("id") or "?") for s in m["skills"]))
            if extra:
                entry["attachments"] = "; ".join(extra)
            if users:
                trace.append("— user sent a new message —")
            users.append(entry)
        elif t == "assistant":
            assistant_count += 1
            model = m.get("model") or {}
            if model.get("id"):
                models.add(f"{model.get('providerID', '?')}/{model['id']}")
            for part in m.get("content") or []:
                if part.get("type") == "tool":
                    tools.append(part.get("name") or "?")
                    trace.append(describe_tool(part))
                    if part.get("name") in EDIT_TOOLS:
                        inp = (part.get("state") or {}).get("input") or {}
                        if isinstance(inp, dict) and (inp.get("path") or inp.get("filePath")):
                            files.add(inp.get("path") or inp.get("filePath"))
                    if part.get("name") in ("shell", "bash"):
                        cmd = ((part.get("state") or {}).get("input") or {}).get("command", "")
                        for m2 in AI_TOOLS.findall(cmd or ""):
                            if m2 not in other_ai:
                                other_ai.append(m2)
                elif part.get("type") == "text" and (part.get("text") or "").strip():
                    final_reply = part["text"]
        elif t == "shell":
            trace.append(f"user ran shell: {squash(m.get('command') or m.get('text') or '', 120)}")

    state = {
        "session_title": session.get("title") or "(untitled)",
        "user_messages": cap_user_messages(users),
        "agent_actions": sample_evenly(collapse(trace), TRACE_CAP),
        "agent_final_reply": clip(final_reply, int(FINAL_REPLY_CHARS * 0.8), int(FINAL_REPLY_CHARS * 0.2)) if final_reply else "(no reply)",
    }
    metrics = {
        "user_messages": len(users),
        "assistant_messages": assistant_count,
        "tool_calls": len(tools),
        "distinct_tools": len(set(tools)),
        "subagent_calls": sum(1 for x in tools if x in ("subagent", "task")),
        "files_edited": len(files),
        "active_seconds": round(active_time(messages) / 1000, 1),
        "wall_seconds": round((last_ms - first_ms) / 1000, 1) if first_ms and last_ms else 0,
        "models_used": ",".join(sorted(models)),
    }
    state["work_pattern"] = {
        "user_messages": len(users),
        "agent_steps_per_user_message": round(len(tools) / max(1, len(users))),
        "agent_working_time": human_duration(metrics["active_seconds"]),
        "subagents_launched": sum(1 for x in tools if x in ("subagent", "task")),
        "other_ai_agents_run_from_shell": other_ai or "none",
    }
    return state, metrics, other_ai


# ---------------------------------------------------------------------------
# TypeSafe
# ---------------------------------------------------------------------------


class Jev:
    def __init__(self, api_key: str, model: str):
        self.api_key, self.model = api_key, model

    def ask(self, state, questions):
        body = json.dumps({"model": self.model, "state": state, "questions": questions}).encode()
        delay = 1.0
        for attempt in range(7):
            req = urllib.request.Request(TYPESAFE_URL, data=body, method="POST", headers={
                "Authorization": f"Bearer {self.api_key}",
                "Content-Type": "application/json",
                "User-Agent": f"judge-my-ai-habits/{SCORER_VERSION}",
            })
            try:
                with urllib.request.urlopen(req, timeout=90) as r:
                    return json.load(r)
            except urllib.error.HTTPError as e:
                detail = e.read().decode(errors="replace")[:500]
                if e.code in (408, 429, 500, 502, 503, 504, 529) and attempt < 6:
                    retry_after = e.headers.get("retry-after")
                    time.sleep(float(retry_after) if retry_after and retry_after.replace(".", "").isdigit() else delay)
                    delay = min(delay * 2, 30)
                    continue
                raise RuntimeError(f"TypeSafe HTTP {e.code}: {detail}")
            except (urllib.error.URLError, TimeoutError, ConnectionError) as e:
                if attempt < 6:
                    time.sleep(delay)
                    delay = min(delay * 2, 30)
                    continue
                raise RuntimeError(f"TypeSafe connection error: {e}")


