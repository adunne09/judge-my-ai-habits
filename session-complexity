# TypeSafe
# ---------------------------------------------------------------------------


class Jev:
    def __init__(self, api_key: str, model: str):
        self.api_key, self.model = api_key, model

    def ask(self, state, questions):
        body = json.dumps({"model": self.model, "state": state, "questions": questions}).encode()
        delay = 1.0
        for attempt in range(7):
            req = urllib.request.Request(TYPESAFE_URL, data=body, method="POST", headers={
                "Authorization": f"Bearer {self.api_key}",
                "Content-Type": "application/json",
                "User-Agent": f"opencode-session-complexity/{SCORER_VERSION}",
            })
            try:
                with urllib.request.urlopen(req, timeout=90) as r:
                    return json.load(r)
            except urllib.error.HTTPError as e:
                detail = e.read().decode(errors="replace")[:500]
                if e.code in (408, 429, 500, 502, 503, 504, 529) and attempt < 6:
                    retry_after = e.headers.get("retry-after")
                    time.sleep(float(retry_after) if retry_after and retry_after.replace(".", "").isdigit() else delay)
                    delay = min(delay * 2, 30)
                    continue
                raise RuntimeError(f"TypeSafe HTTP {e.code}: {detail}")
            except (urllib.error.URLError, TimeoutError, ConnectionError) as e:
                if attempt < 6:
                    time.sleep(delay)
                    delay = min(delay * 2, 30)
                    continue
                raise RuntimeError(f"TypeSafe connection error: {e}")


