def base_row(machine, session, children, opencode_version):
    created = (session.get("time") or {}).get("created") or 0
    local = dt.datetime.fromtimestamp(created / 1000)
    iso = local.isocalendar()
    tok = session.get("tokens") or {}
    cache = tok.get("cache") or {}
    own_total = sum(int(tok.get(k) or 0) for k in ("input", "output", "reasoning")) + int(cache.get("read") or 0) + int(cache.get("write") or 0)
    child_total, child_cost = 0, 0.0
    for c in children:
        ct = c.get("tokens") or {}
        cc = ct.get("cache") or {}
        child_total += sum(int(ct.get(k) or 0) for k in ("input", "output", "reasoning")) + int(cc.get("read") or 0) + int(cc.get("write") or 0)
        child_cost += float(c.get("cost") or 0)
    model = session.get("model") or {}
    return {
        "machine": machine,
        "session_id": session["id"],
        "title": session.get("title"),
        "directory": tidy((session.get("location") or {}).get("directory") or ""),
        "project_id": session.get("projectID"),
        "agent": session.get("agent"),
        "model": f"{model.get('providerID')}/{model.get('id')}" if model.get("id") else None,
        "fork_of": (session.get("fork") or {}).get("sessionID"),
        "launched_by_program": int(bool((session.get("metadata") or {}).get("source") or session.get("permissions"))),
        "launch_source": (session.get("metadata") or {}).get("source"),
        "created_at": dt.datetime.fromtimestamp(created / 1000, dt.timezone.utc).isoformat(timespec="seconds"),
        "created_ms": created,
        "updated_ms": (session.get("time") or {}).get("updated"),
        "day": local.strftime("%Y-%m-%d"),
        "week": f"{iso[0]}-W{iso[1]:02d}",
        "month": local.strftime("%Y-%m"),
        "outcome": session.get("outcome"),
        "subagent_sessions": len(children),
        "tokens_input": tok.get("input"),
        "tokens_output": tok.get("output"),
        "tokens_reasoning": tok.get("reasoning"),
        "tokens_cache_read": cache.get("read"),
        "tokens_cache_write": cache.get("write"),
        "tokens_total": own_total + child_total,
        "cost_usd": round(float(session.get("cost") or 0) + child_cost, 6),
        "opencode_version": opencode_version,
    }


def score_one(oc, jev, machine, session, children, opencode_version):
    row = base_row(machine, session, children, opencode_version)
    row["scorer_hash"], row["scored_at"] = SCORER_HASH, dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    try:
        state, metrics, other_ai = analyze(session, oc.messages(session["id"]))
        row.update(metrics)
        if metrics["user_messages"] == 0 or metrics["assistant_messages"] == 0:
            row["status"] = "empty"
            return row, 0
        # child sessions are the authoritative count of subagents launched
        state["work_pattern"]["subagents_launched"] = max(len(children), state["work_pattern"]["subagents_launched"])
        resp = jev.ask(state, QUESTIONS)
        a = resp["answers"]
        cx = a["complexity"]
        probs = {int(k): v for k, v in cx["probabilities"].items()}
        org = a["origin"]["probabilities"]
        row.update({
            "status": "scored",
            "complexity": cx["score"],
            "complexity_confidence": cx["confidence"],
            **{f"complexity_p{i}": probs.get(i) for i in range(7)},
            "leverage": a["leverage"]["score"],
            **{k: a[k]["score"] for k in DIMENSIONS},
            "origin": a["origin"]["choice"],
            "origin_p_personal": org.get("personal_work"),
            "origin_p_scripted": org.get("scripted_job"),
            "origin_p_test": org.get("test_or_benchmark"),
            "answers_json": json.dumps({k: {kk: vv for kk, vv in v.items() if kk != "legend"} for k, v in a.items()}),
            "jev_model": resp.get("model"),
            "state_tokens": (resp.get("usage") or {}).get("input_tokens"),
        })
        return row, row["state_tokens"] or 0
    except Exception as e:  # keep going; the row records the failure and is retried next run
        row["status"], row["error"] = "error", str(e)[:1000]
        return row, 0


def cmd_score(args):
    api_key = os.environ.get("TYPESAFE_API_KEY")
    if not api_key and not args.dry_run:
        sys.exit("error: set TYPESAFE_API_KEY (get one at https://console.typesafe.ai)")
    oc = OpenCode(find_opencode())
    version = oc.version()
    if not re.search(r"\bv?2\.", version):
        print(f"warning: expected OpenCode v2, found {version!r}", file=sys.stderr)
    machine = args.machine or socket.gethostname().split(".")[0]
    db = connect(pathlib.Path(args.db).expanduser())
    jev = Jev(api_key or "", args.model)

    print(f"machine={machine} opencode={version} model={args.model} scorer={SCORER_HASH} db={args.db}", file=sys.stderr)
    all_sessions = oc.sessions()
    children = {}
    for s in all_sessions:
        if s.get("parentID"):
            children.setdefault(s["parentID"], []).append(s)
    roots = [s for s in all_sessions if not s.get("parentID")]
    if args.since:
        cutoff = dt.datetime.fromisoformat(args.since).timestamp() * 1000
        roots = [s for s in roots if (s.get("time") or {}).get("created", 0) >= cutoff]
    if args.session:
        roots = [s for s in roots if s["id"] in set(args.session)]

    done = {}
    for sid, updated, status, scorer, model in db.execute("SELECT session_id, updated_ms, status, scorer_hash, jev_model FROM sessions WHERE machine = ?", (machine,)):
        done[sid] = (updated, status, scorer, model)

    def stale(s):
        prev = done.get(s["id"])
        if args.rescore or prev is None:
            return True
        updated, status, scorer, _ = prev
        return status == "error" or scorer != SCORER_HASH or updated != (s.get("time") or {}).get("updated")

    todo = [s for s in roots if stale(s)]
    todo.sort(key=lambda s: -((s.get("time") or {}).get("created") or 0))
    if args.limit:
        todo = todo[: args.limit]
    print(f"{len(all_sessions)} sessions ({len(roots)} top-level); {len(todo)} to score", file=sys.stderr)

    if args.dry_run:
        for s in todo[: args.limit or 3]:
            state, metrics, _ = analyze(s, oc.messages(s["id"]))
            print(json.dumps({"session_id": s["id"], "metrics": metrics, "state": state}, indent=2, ensure_ascii=False))
        return

    started = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    lock = threading.Lock()
    counts = {"scored": 0, "empty": 0, "error": 0}
    tokens = 0
    t0 = time.time()
    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(score_one, oc, jev, machine, s, children.get(s["id"], []), version) for s in todo]
        for i, fut in enumerate(as_completed(futures), 1):
            row, used = fut.result()
            with lock:
                upsert(db, row)
                counts[row["status"]] += 1
                tokens += used
                if i % 25 == 0 or i == len(futures):
                    db.commit()
                    print(f"  {i}/{len(futures)}  scored={counts['scored']} empty={counts['empty']} errors={counts['error']}  {time.time() - t0:.0f}s", file=sys.stderr)
                if row["status"] == "error":
                    print(f"  error {row['session_id']}: {row['error'][:200]}", file=sys.stderr)
    db.execute("INSERT INTO runs VALUES (?,?,?,?,?,?,?,?,?,?)", (machine, started, dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), version, args.model, SCORER_HASH, len(roots), counts["scored"], counts["error"], tokens))
    db.commit()
    print(f"done: {counts}; Jev input tokens {tokens:,} (~${tokens * 0.042 / 1e6:.4f})", file=sys.stderr)
    print(f"database: {pathlib.Path(args.db).expanduser()}", file=sys.stderr)


def cmd_merge(args):
    out = connect(pathlib.Path(args.output).expanduser())
    for src in args.inputs:
        out.execute("ATTACH DATABASE ? AS src", (str(pathlib.Path(src).expanduser()),))
        n = out.execute(f"INSERT OR REPLACE INTO sessions ({','.join(COLUMNS)}) SELECT {','.join(COLUMNS)} FROM src.sessions").rowcount
        try:
            out.execute("INSERT INTO runs SELECT * FROM src.runs")
        except sqlite3.OperationalError:
            pass
        out.commit()
        out.execute("DETACH DATABASE src")
        print(f"merged {n} rows from {src}", file=sys.stderr)
    hashes = out.execute("SELECT scorer_hash, jev_model, COUNT(*) FROM sessions WHERE status='scored' GROUP BY 1, 2").fetchall()
    if len(hashes) > 1:
        print("warning: rows were scored with different question sets or models; compare like with like:", file=sys.stderr)
        for h in hashes:
            print(f"  scorer={h[0]} model={h[1]} rows={h[2]}", file=sys.stderr)


def cmd_report(args):
    db = sqlite3.connect(str(pathlib.Path(args.db).expanduser()))
    if args.all:
        table = "sessions WHERE status='scored'"
        print("\nAll scored sessions (--all; includes tests, scripted jobs, and forks)")
    else:
        # Personal sessions are the ones the trend tracks; show the funnel from
        # everything scored down to them.
        total, unscored = db.execute("SELECT COUNT(*), SUM(status != 'scored') FROM sessions").fetchone()
        non_personal = db.execute("SELECT COUNT(*) FROM sessions WHERE status='scored' AND origin IS NOT 'personal_work'").fetchone()[0]
        forks = db.execute("SELECT COUNT(*) FROM sessions WHERE status='scored' AND fork_of IS NOT NULL").fetchone()[0]
        launcher = db.execute("SELECT COUNT(*) FROM sessions WHERE status='scored' AND launched_by_program = 1").fetchone()[0]
        personal = db.execute("SELECT COUNT(*) FROM sessions WHERE status='scored' AND origin='personal_work' AND fork_of IS NULL AND launched_by_program = 0").fetchone()[0]
        print("\nPERSONAL SESSIONS — scored, personal work, not forks, launched by a human:")
        print(f"  {total} sessions -> {personal} analyzed below "
              f"(excluded: {unscored} unscored, {non_personal} scripted/test/benchmark, "
              f"{forks} forks, {launcher} launcher-created; categories may overlap)")
        table = "human_sessions WHERE 1=1"
    period = {"month": "month", "week": "week", "day": "day"}[args.by]
    rows = db.execute(f"SELECT {period}, complexity FROM {table} ORDER BY created_ms").fetchall()
    if not rows:
        print("no scored sessions")
        return
    values = [r[1] for r in rows]

    def stats(xs):
        n = len(xs)
        mean = sum(xs) / n
        sd = math.sqrt(sum((x - mean) ** 2 for x in xs) / (n - 1)) if n > 1 else 0.0
        med = sorted(xs)[n // 2]
        return n, mean, sd, med

    n, mean, sd, med = stats(values)
    print(f"\nComplexity: n={n} mean={mean:.2f} sd={sd:.2f} median={med:.2f}")
    print("levels: 0 minutes · 1 <1h · 2 few hours · 3 a day · 4 several days · 5 weeks · 6 months for a team\n")
    bins = [0] * 24
    for v in values:
        bins[min(23, int(v / 0.25))] += 1
    top = max(bins)
    for i, c in enumerate(bins):
        print(f"  {i * 0.25:4.2f}-{(i + 1) * 0.25:4.2f} | {'█' * round(40 * c / top):<40} {c}")
    lev = [r[0] for r in db.execute(f"SELECT leverage FROM {table.replace('WHERE 1=1', 'WHERE leverage IS NOT NULL') if 'WHERE 1=1' in table else table + ' AND leverage IS NOT NULL'}")]
    if lev:
        ln = len(lev)
        print(f"\nLeverage: n={ln} mean={sum(lev) / ln:.2f}")
        print("levels: 0 answered from knowledge · 1 a lookup or two · 2 steered step by step · 3 delegated a goal · 4 orchestrated agents · 5 autonomous loop\n")
        lbins = [0] * 10
        for v in lev:
            lbins[min(9, int(v * 2))] += 1
        ltop = max(lbins)
        for i, c in enumerate(lbins):
            print(f"  {i * 0.5:3.1f}-{(i + 1) * 0.5:3.1f} | {'█' * round(40 * c / ltop):<40} {c}")
    print(f"\nBy {args.by}:")
    groups = {}
    for p, v in rows:
        groups.setdefault(p, []).append(v)
    for p, xs in groups.items():
        n, mean, sd, med = stats(xs)
        print(f"  {p}  n={n:4d}  mean={mean:.2f}  sd={sd:.2f}  median={med:.2f}  {'▇' * round(mean * 8)}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    s = sub.add_parser("score", help="score sessions on this machine (default)")
    s.add_argument("--db", default=str(DEFAULT_DB), help=f"SQLite output (default {DEFAULT_DB})")
    s.add_argument("--machine", help="machine label stored with each row (default: short hostname)")
    s.add_argument("--model", default=DEFAULT_MODEL, help=f"Jev model; pinned so scores stay comparable over time (default {DEFAULT_MODEL})")
    s.add_argument("--workers", type=int, default=6)
    s.add_argument("--since", help="only sessions created on or after this date (YYYY-MM-DD)")
    s.add_argument("--limit", type=int, help="score at most N sessions (newest first)")
    s.add_argument("--session", action="append", help="score only this session id (repeatable)")
    s.add_argument("--rescore", action="store_true", help="rescore sessions even if unchanged")
    s.add_argument("--dry-run", action="store_true", help="print the state Jev would see, without calling Jev")
    m = sub.add_parser("merge", help="merge databases from several machines into one")
    m.add_argument("inputs", nargs="+")
    m.add_argument("-o", "--output", required=True)
    r = sub.add_parser("report", help="print the distribution and its trend")
    r.add_argument("--db", default=str(DEFAULT_DB))
    r.add_argument("--by", choices=["month", "week", "day"], default="month")
    r.add_argument("--all", action="store_true", help="include tests, scripted jobs, and forks")
    argv = sys.argv[1:]
    if not argv or argv[0] not in ("score", "merge", "report", "-h", "--help"):
        argv = ["score"] + argv
    args = p.parse_args(argv)
    {"score": cmd_score, "merge": cmd_merge, "report": cmd_report}[args.cmd](args)


if __name__ == "__main__":
    main()
